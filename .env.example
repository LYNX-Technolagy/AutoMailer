# AutoMailer local configuration

# Local-only binding by default.
HOST=127.0.0.1
PORT=3000

# Session signing secret.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-secret

# Only enable these when deliberately using an HTTPS reverse proxy.
TRUST_PROXY_HOPS=0
COOKIE_SECURE=false

# Simulate sending without delivering emails.
DRY_RUN=false