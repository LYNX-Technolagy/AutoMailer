# Server port
PORT=3000

# Session secret — long random string. Used to sign session cookies.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Resend (https://resend.com) — required for real sending.
# 1. Create an account and verify a domain you own.
# 2. Generate an API key (starts with re_).
# 3. Set RESEND_FROM to a verified sender on that domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=AutoMailer <hello@yourdomain.com>

# Set to true to skip actual sending (logs only) — useful for testing without Resend
DRY_RUN=false